<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GAVEL — Online Auction House</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

    <!-- ═══ NAV ═══ -->
    <nav class="nav">
        <div class="nav-inner">
            <div class="logo" onclick="showPage('home')">
                <i class="fa-solid fa-gavel logo-accent"></i>GAVEL<span class="logo-accent">.</span>
            </div>
            <div class="nav-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search auctions…" id="searchInput" oninput="handleSearch(this.value)">
            </div>
            <div class="nav-links">
                <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house"></i> Home
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Store" ? "active" : "")"
                   asp-controller="Store" asp-action="Index">
                    <i class="fa-solid fa-store"></i> Store
                </a>
                    <div class="cat-dd">
                        <button class="nav-link">
                            <i class="fa-solid fa-grid-2"></i> Categories
                            <i class="fa-solid fa-chevron-down" style="font-size:10px"></i>
                        </button>

                        <div class="cat-dd-menu">

                            <!-- All Items -->
                            <a class="dd-item" asp-controller="Store" asp-action="Index">
                                <i class="fa-solid fa-border-all"></i> All Items
                            </a>

                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in ViewBag.Categories)
                                {
                                    <a class="dd-item"
                                           asp-controller="Store"
                                           asp-action="Category"
                                           asp-route-id="@cat.Id">

                                        <i class="fa-solid fa-folder"></i> @cat.Name
                                    </a>
                                }
                            }

                        </div>
                    </div>
                <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "About" ? "active" : "")"
                   asp-controller="Home" asp-action="About">
                    <i class="fa-solid fa-circle-info"></i> About
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Contact" ? "active" : "")"
                   asp-controller="Home" asp-action="Contact">
                    <i class="fa-solid fa-envelope"></i> Contact
                </a>
                @if (Context.Session.GetInt32("UserId") == null)
                {
                    <a class="btn-nav-cta" asp-controller="Account" asp-action="Register">
                        <i class="fa-solid fa-user-plus"></i> Sign Up
                    </a>
                }
                else if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a class="btn-nav-cta" asp-controller="Admin" asp-action="Index">
                        <i class="fa-solid fa-shield-halved"></i> Admin Panel
                    </a>
                }
                else
                {
                    <a class="btn-nav-cta" asp-controller="Profile" asp-action="Index">
                        <i class="fa-solid fa-user"></i> Profile
                    </a>
                }
            </div>
            <button class="hamburger" onclick="toggleMob()"><i class="fa-solid fa-bars"></i></button>
        </div>
    </nav>

    <!-- ═══ MOBILE MENU ═══ -->
    <div class="mob-menu" id="mobMenu">
        <div class="mob-menu-hdr">
            <div class="logo"><i class="fa-solid fa-gavel logo-accent"></i>GAVEL<span class="logo-accent">.</span></div>
            <button class="mob-close" onclick="toggleMob()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="mob-links">
            <button class="mob-link" onclick="showPage('home');toggleMob()"><i class="fa-solid fa-house"></i> Home</button>
            <button class="mob-link" onclick="showPage('store');toggleMob()"><i class="fa-solid fa-store"></i> Store</button>
            <div class="mob-div"></div>
            <button class="mob-link" onclick="goStore('Electronics');toggleMob()"><i class="fa-solid fa-laptop"></i> Electronics</button>
            <button class="mob-link" onclick="goStore('Art');toggleMob()"><i class="fa-solid fa-palette"></i> Art & Antiques</button>
            <button class="mob-link" onclick="goStore('Watches');toggleMob()"><i class="fa-solid fa-clock"></i> Watches</button>
            <button class="mob-link" onclick="goStore('Fashion');toggleMob()"><i class="fa-solid fa-bag-shopping"></i> Fashion</button>
            <button class="mob-link" onclick="goStore('Collectibles');toggleMob()"><i class="fa-solid fa-trophy"></i> Collectibles</button>
            <button class="mob-link" onclick="goStore('Vehicles');toggleMob()"><i class="fa-solid fa-car"></i> Vehicles</button>
            <div class="mob-div"></div>
            <button class="mob-link" onclick="showPage('about');toggleMob()"><i class="fa-solid fa-circle-info"></i> About</button>
            <button class="mob-link" onclick="showPage('contact');toggleMob()"><i class="fa-solid fa-envelope"></i> Contact</button>
            <div style="margin-top:20px"><button class="btn-primary" style="width:100%;justify-content:center;border-radius:var(--radius)"><i class="fa-solid fa-right-to-bracket"></i> Sign In</button></div>
        </div>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="footer-top">
            <div>
                <div class="f-brand-name"><i class="fa-solid fa-gavel" style="color:var(--accent);font-size:18px"></i>GAVEL<span style="color:var(--accent)">.</span></div>
                <div class="f-brand-desc">The premier destination for rare and extraordinary auction items. Connecting collectors and sellers worldwide since 2015.</div>
                <div class="f-social">
                    <button class="f-soc-btn"><i class="fa-brands fa-x-twitter"></i></button>
                    <button class="f-soc-btn"><i class="fa-brands fa-instagram"></i></button>
                    <button class="f-soc-btn"><i class="fa-brands fa-facebook-f"></i></button>
                    <button class="f-soc-btn"><i class="fa-brands fa-linkedin-in"></i></button>
                </div>
            </div>
            <div>
                <div class="f-col-title">Explore</div>
                <ul class="f-links">
                    <li><a onclick="showPage('store')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Live Auctions</a></li>
                    <li><a onclick="showPage('store')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Upcoming Lots</a></li>
                    <li><a onclick="showPage('store')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Past Results</a></li>
                    <li><a onclick="showPage('store')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Collections</a></li>
                </ul>
            </div>
            <div>
                <div class="f-col-title">Company</div>
                <ul class="f-links">
                    <li><a onclick="showPage('about')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> About Us</a></li>
                    <li><a onclick="showPage('about')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> How It Works</a></li>
                    <li><a onclick="showPage('about')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Our Team</a></li>
                    <li><a onclick="showPage('contact')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Press</a></li>
                </ul>
            </div>
            <div>
                <div class="f-col-title">Support</div>
                <ul class="f-links">
                    <li><a onclick="showPage('contact')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Help Centre</a></li>
                    <li><a onclick="showPage('contact')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Bidding Guide</a></li>
                    <li><a onclick="showPage('contact')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Privacy Policy</a></li>
                    <li><a onclick="showPage('contact')"><i class="fa-solid fa-chevron-right" style="font-size:10px;opacity:.4"></i> Contact Us</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <div>© 2026 GAVEL Auction House. All rights reserved.</div>
            <div style="display:flex;align-items:center;gap:16px">
                <span><i class="fa-solid fa-location-dot" style="margin-right:5px;opacity:.5"></i>London, UK</span>
                <span><i class="fa-solid fa-phone" style="margin-right:5px;opacity:.5"></i>+44 20 7946 0958</span>
            </div>
        </div>
    </footer>

    <div class="toast" id="toastEl"><i id="toastIcon" class="fa-solid fa-circle-check"></i><span id="toastMsg"></span></div>

    <script src="~/js/script.js" asp-append-version="true"></script>
</body>
</html>
