@{
    Layout = "_Layout"; // make sure this is set
}
@model OnlineAuction.Models.LoginViewModel

<div class="auth-page">
    <div class="auth-card">

        <!-- Logo -->
        <div class="auth-card-logo" onclick="location.href='@Url.Action("Index", "Home")'">
            <i class="fa-solid fa-gavel"></i>GAVEL<span>.</span>
        </div>

        <!-- Login Form -->
        <form asp-action="Login" method="post" class="login-main-form">
            <div class="auth-card-title">Welcome back</div>
            <div class="auth-card-sub">Sign in to your account to continue bidding.</div>

            <div class="auth-social-row">
                <button type="button" class="auth-social-btn" onclick="alert('Social login coming soon!')">
                    <i class="fa-brands fa-google" style="color:#EA4335"></i> Google
                </button>
                <button type="button" class="auth-social-btn" onclick="alert('Social login coming soon!')">
                    <i class="fa-brands fa-apple" style="color:#1A1612"></i> Apple
                </button>
            </div>

            <div class="auth-divider"><span>or continue with email</span></div>

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="auth-field">
                <label class="auth-label"><i class="fa-solid fa-envelope"></i> Email</label>
                <div class="auth-input-wrap">
                    <i class="auth-input-icon fa-solid fa-envelope"></i>
                    <input asp-for="Email" class="auth-input" placeholder="you@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="auth-field-hint"></span>
            </div>

            <div class="auth-field">
                <label class="auth-label"><i class="fa-solid fa-lock"></i> Password</label>
                <div class="auth-input-wrap">
                    <i class="auth-input-icon fa-solid fa-lock"></i>
                    <input asp-for="Password" type="password" class="auth-input" placeholder="Enter your password" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="auth-field-hint"></span>
            </div>

            <div class="auth-check-row">
                <input asp-for="RememberMe" class="auth-checkbox" />
                <label class="auth-check-label" for="RememberMe">Keep me signed in for 30 days</label>
            </div>

            <button type="submit" class="auth-submit">
                <i class="fa-solid fa-right-to-bracket"></i> Sign In
            </button>

            <div class="auth-redirect">
                Don't have an account? <a href="@Url.Action("Register", "Account")">Create one free</a>
            </div>
        </form>
    </div>
</div>