@{
    Layout = "_Layout"; // make sure this is set
}
@model OnlineAuction.Models.RegisterViewModel

<div class="auth-page">
    <div class="auth-card">

        <!-- Logo -->
        <div class="auth-card-logo" onclick="location.href='@Url.Action("Index", "Home")'">
            <i class="fa-solid fa-gavel"></i>GAVEL<span>.</span>
        </div>

        <!-- Register Form -->
        <form asp-action="Register" method="post" class="signup-main-form">
            <div class="auth-card-title">Create an account</div>
            <div class="auth-card-sub">Free to join. Start bidding in minutes.</div>

            <div class="auth-social-row">
                <button type="button" class="auth-social-btn" onclick="alert('Social signup coming soon!')">
                    <i class="fa-brands fa-google" style="color:#EA4335"></i> Google
                </button>
                <button type="button" class="auth-social-btn" onclick="alert('Social signup coming soon!')">
                    <i class="fa-brands fa-apple" style="color:#1A1612"></i> Apple
                </button>
            </div>

            <div class="auth-divider"><span>or sign up with email</span></div>

            <div asp-validation-summary="All" class="text-danger"></div>

            <div>
                <div class="auth-field">
                    <label class="auth-label"><i class="fa-solid fa-user"></i> Full Name</label>
                    <div class="auth-input-wrap">
                        <i class="auth-input-icon fa-solid fa-user"></i>
                        <input asp-for="FullName" class="auth-input" placeholder="James Harrow" autocomplete="name" />
                    </div>
                    <span asp-validation-for="FullName" class="auth-field-hint"></span>
                </div>
            </div>

            <div class="auth-field">
                <label class="auth-label"><i class="fa-solid fa-envelope"></i> Email</label>
                <div class="auth-input-wrap">
                    <i class="auth-input-icon fa-solid fa-envelope"></i>
                    <input asp-for="Email" class="auth-input" placeholder="you@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="auth-field-hint"></span>
            </div>

            <div class="auth-field">
                <label class="auth-label"><i class="fa-solid fa-lock"></i> Password</label>
                <div class="auth-input-wrap">
                    <i class="auth-input-icon fa-solid fa-lock"></i>
                    <input asp-for="Password" type="password" class="auth-input" placeholder="Create a strong password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="auth-field-hint"></span>
            </div>

            <div class="auth-field">
                <label class="auth-label"><i class="fa-solid fa-shield-check"></i> Confirm Password</label>
                <div class="auth-input-wrap">
                    <i class="auth-input-icon fa-solid fa-shield-check"></i>
                    <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="Repeat your password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-field-hint"></span>
            </div>

            <div class="auth-check-row">
                <input asp-for="AcceptTerms" class="auth-checkbox" />
                <label class="auth-check-label" for="AcceptTerms">
                    I agree to GAVEL's <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
                </label>
            </div>

            <button type="submit" class="auth-submit">
                <i class="fa-solid fa-user-plus"></i> Create Account
            </button>

            <div class="auth-redirect">
                Already have an account? <a href="@Url.Action("Login", "Account")">Sign in</a>
            </div>
        </form>
    </div>
</div>